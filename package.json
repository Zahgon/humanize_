{
  "name": "humanize-plus",
  "title": "Humanize",
  "description": "A simple utility library for making the web more humane.",
  "version": "1.8.2",
  "license": "MIT",
  "homepage": "https://github.com/HubSpot/humanize",
  "main": "./dist/humanize.js",
  "types": "./dist/humanize.d.ts",
  "author": {
    "name": "HubSpotDev",
    "email": "devteam@hubspot.com",
    "url": "dev.hubspot.com"
  },
  "maintainers": [
    {
      "name": "Jonathan Kim",
      "email": "me@jonathan-kim.com",
      "web": "http://jonathan-kim.com"
    },
    {
      "name": "Bryan Ash",
      "email": "ashbryanct@gmail.com",
      "web": "http://github.com/b-ash"
    },
    {
      "name": "Andy Aylward",
      "email": "aaylward@gmail.com",
      "web": "http://github.com/aaylward"
    },
    {
      "name": "Nicholas Hwang",
      "email": "geek@nicholashwang.com",
      "web": "http://github.com/geekjuice"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/HubSpot/humanize.git"
  },
  "bugs": {
    "url": "https://github.com/HubSpot/humanize/issues"
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "reinstall": "del-cli node_modules && npm install",
    "clean": "del-cli dist",
    "compile": "tsc -p tsconfig.build.json",
    "uglify": "uglifyjs dist/humanize.js -c arrows=false -m -o dist/humanize.min.js",
    "copytypes": "node -e \"require('fs').copyFileSync('types/humanize.d.ts', 'dist/humanize.d.ts')\"",
    "header": "ts-node bin/header.ts",
    "build": "npm run clean && npm run compile && npm run uglify && npm run header && npm run copytypes",
    "watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "ts-node __tests__/runner.ts"
  },
  "devDependencies": {
    "@types/jasmine": "^5.1.4",
    "@types/node": "^20.11.0",
    "del-cli": "^5.1.0",
    "glob": "^10.3.10",
    "jasmine": "^5.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "uglify-js": "^3.17.4"
  }
}
